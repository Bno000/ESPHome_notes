# JC4880P443 Dual MCU ESP32 P4 LCD
# Display uses MIPI LCD driver
# Touch uses a GT911

# Backlight GPIO output
output:
  - id: gpio_backlight_pwm
    platform: ledc
    pin: 23
# Backlight Light object
light:
  - id: backlight
    name: Backlight
    platform: monochromatic
    output: gpio_backlight_pwm
    restore_mode: ALWAYS_ON

http_request:  # Needed by esp32_hosted-update and any JSON stuff
  buffer_size_rx: 2048

update:
  - platform: esp32_hosted
    name: ESP-Hosted Firmware
    icon: mdi:chip
    type: http
    source: https://esphome.github.io/esp-hosted-firmware/manifest/esp32c6.json
    update_interval: 6h

esp32:
  board: esp32-p4-evboard
  variant: esp32p4
  flash_size: 16MB
  cpu_frequency: 360MHz
  framework:
    type: esp-idf
    advanced:
      execute_from_psram: true

display:
  - platform: mipi_dsi
    id: device_display
    model: JC4880P443
    update_interval: never
    auto_clear_enabled: false

touchscreen:
  platform: gt911
  i2c_id: i2c_bus
  id: device_touchscreen
  reset_pin: GPIO3
  update_interval: 100ms

esp_ldo:
  - channel: 3
    voltage: 2.5V

psram:
  mode: hex
  speed: 200MHz

preferences:
  flash_write_interval: 5min

esp32_hosted:
  active_high: true
  variant: ESP32C6
  reset_pin: GPIO54
  cmd_pin: GPIO19
  clk_pin: GPIO18
  d0_pin: GPIO14
  d1_pin: GPIO15
  d2_pin: GPIO16
  d3_pin: GPIO17

i2c:
  id: i2c_bus
  sda: 7
  scl: 8
  scan: false
  frequency: 400kHz

# Note - Aditional LVGL settings need to be set per below to initialise the display correctly.
# Rotation got moved out of the driver section and into the LVGL section in ESPHome sone time in 2026
lvgl:
  buffer_size: 100%
  rotation: 90
  width: 800
  height: 480
  byte_order: little_endian
